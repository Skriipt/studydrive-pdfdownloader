{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.4.0",
  "minimum_chrome_version": "111",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": ["downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "download-pdf": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "__MSG_commandDownload__"
    }
  },
  "options_ui": {
    "page": "onboarding.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.studydrive.net/*"],
      "js": ["utils.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.studydrive.net/*"],
      "js": ["utils.js", "ui-styles.js", "content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

{
  "name": "studydrive-pdf-downloader",
  "version": "1.2.0",
  "private": true,
  "description": "Chromium extension that adds a StudyDrive-styled PDF download button to StudyDrive document pages.",
  "type": "commonjs",
  "scripts": {
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "lint": "node scripts/lint.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=18"
  }
}

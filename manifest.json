{
  "manifest_version": 3,
  "name": "StudyDrive PDF Downloader",
  "version": "1.2.0",
  "description": "Download PDF documents from StudyDrive",
  "permissions": ["downloads"],
  "host_permissions": ["https://www.studydrive.net/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StudyDrive PDF Downloader",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.studydrive.net/*/doc/*"],
      "js": ["utils.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.studydrive.net/*/doc/*"],
      "js": ["utils.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
